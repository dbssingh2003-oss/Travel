# API
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/dbbestworlds
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments — Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS / OTP (Twilio or MSG91)
SMS_PROVIDER=console   # set to "twilio" or "msg91" in prod
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email (Amazon SES or SMTP)
EMAIL_PROVIDER=console   # set to "ses" or "smtp" in prod
EMAIL_FROM=noreply@dbbestworlds.app
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Web
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_WS_URL=ws://localhost:4000
VITE_RAZORPAY_KEY_ID=
