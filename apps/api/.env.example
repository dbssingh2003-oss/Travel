# ==============================================================================
# DB Best Worlds — API Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Redis Cache & Message Queue
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets (Generate strong 64-char random strings for production)
# Example: openssl rand -base64 48
JWT_ACCESS_SECRET="change-this-to-a-secure-random-string-min-32-chars"
JWT_REFRESH_SECRET="change-this-to-a-different-secure-random-string-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=10

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# SMS / OTP Provider ("console" | "twilio")
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Email Provider ("console" | "ses")
EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@dbbestworlds.app"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
