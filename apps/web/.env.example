# Vercel Environment Variables Configuration
# Set these in your Vercel Project Settings -> Environment Variables

# URL of your deployed Fastify backend API (e.g., https://api.yourdomain.com/api/v1 or Render/Railway/Fly.io URL)
VITE_API_BASE_URL=https://api.example.com/api/v1

# WebSocket URL for real-time live booking tracking (e.g., https://api.yourdomain.com)
VITE_WS_URL=https://api.example.com

# Razorpay Publishable Key (optional for production payments)
VITE_RAZORPAY_KEY_ID=
